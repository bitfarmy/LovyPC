#!/bin/bash
# ============================================================
# pcwin — Controlla il tuo PC Windows da Fedora
# Client remoto universale: terminale, cartelle, tunnel servizi
#
# Comandi:
#   term | cmd | monta | smonta | gui | status
#   setup-ssh                  → accesso senza password (chiave SSH)
#   tramamind [stop|auto|noauto]   → tunnel OmniRoute :20128
#   tramamind ui [stop]            → tunnel OpenHands :3000
#   ollama [stop]                  → tunnel Ollama :11434 (debug)
#   installa-service | disinstalla-service
# ============================================================

CONFIG_FILE="${PCWIN_CONFIG:-$HOME/.config/pcwin.conf}"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Config non trovata: $CONFIG_FILE"
    echo "Copia l'esempio:  cp pcwin.conf.example ~/.config/pcwin.conf"
    echo "e modifica IP/nome utente."
    exit 1
fi
source "$CONFIG_FILE"

# Fuori da ~/ : ls, Nautilus e i selettori file non aspettano un FUSE bloccato.
MOUNT_POINT="${MOUNT_POINT:-$HOME/.local/share/lovypc/pc-windows}"
LEGACY_MOUNT="$HOME/pc-windows"
USER_SYSTEMD="$HOME/.config/systemd/user"
# Timeout corti: se Windows è spento, sshfs fallisce in pochi secondi.
SSHFS_OPTS="reconnect,ConnectTimeout=2,ConnectionAttempts=1,ServerAliveInterval=5,ServerAliveCountMax=2,dir_cache=yes,entry_timeout=5,attr_timeout=5"

# ---------- supporto ----------
require() {
    command -v "$1" &>/dev/null || { echo "Manca: sudo dnf install $2"; exit 1; }
}

# True se path è un mount. Legge mountinfo: non fa stat sul FUSE
# (un Windows spento blocca stat per tutto il timeout SSH).
is_mounted() {
    local parent base want
    parent=$(dirname -- "$1")
    base=$(basename -- "$1")
    parent=$(realpath -m -- "$parent" 2>/dev/null) || return 1
    want="$parent/$base"
    awk -v want="$want" '
        {
            mp = $5
            gsub(/\\040/, " ", mp)
            gsub(/\\011/, "\t", mp)
            if (mp == want) found = 1
        }
        END { exit found ? 0 : 1 }
    ' /proc/self/mountinfo
}

# Smonta path se risulta in mountinfo. 0 ok, 1 errore, 2 non montato.
smonta_path() {
    local mp="$1"
    is_mounted "$mp" || return 2
    if fusermount3 -u "$mp" 2>/dev/null || fusermount3 -uz "$mp" 2>/dev/null; then
        echo "Smontato: $mp"
        return 0
    fi
    echo "❌ Non riesco a smontare $mp. Chiudi i programmi che la stanno usando."
    return 1
}

check_reachable() {
    ping -c1 -W2 "$WIN_IP" &>/dev/null || {
        echo "⚠️  PC Windows ($WIN_IP) non raggiungibile."
        exit 1
    }
}

use_systemd() {
    [ -d "$USER_SYSTEMD" ] && ls "$USER_SYSTEMD"/pcwin-*.service &>/dev/null
}

# ---------- setup ssh ----------
setup_ssh() {
    local key="$HOME/.ssh/id_ed25519"

    # 1. Chiave: creala se manca (senza passphrase)
    if [ ! -f "$key" ]; then
        echo "[..] Creo la chiave SSH..."
        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
        ssh-keygen -t ed25519 -N "" -f "$key" -q
        echo "[OK] Chiave creata: $key"
    fi

    check_reachable

    # 2. Se il login senza password funziona già, hai finito
    if ssh -o BatchMode=yes -o PasswordAuthentication=no -o ConnectTimeout=5 \
            -o StrictHostKeyChecking=accept-new "$WIN_USER@$WIN_IP" exit 2>/dev/null; then
        echo "✅ Accesso SSH senza password già attivo."
        exit 0
    fi

    # 3. Installa la chiave sul Windows (chiede la password Windows UNA volta)
    #    + corregge i permessi (sshd di Windows rifiuta chiavi con ACL troppo aperte)
    #    + gestisce anche gli utenti amministratori (administrators_authorized_keys)
    echo "[..] Installazione chiave su $WIN_USER@$WIN_IP"
    echo "     (inserisci la password Windows UNA volta)"
    local pub
    pub=$(cat "$key.pub")
    ssh -o StrictHostKeyChecking=accept-new "$WIN_USER@$WIN_IP" \
        "powershell -NoProfile -Command \"\$d='C:/Users/$WIN_USER/.ssh'; New-Item -ItemType Directory -Force -Path \$d | Out-Null; \$f=(\$d+'/authorized_keys'); if (-not (Test-Path \$f)) { New-Item -ItemType File -Path \$f | Out-Null }; \$k='$pub'; \$c=Get-Content \$f -Raw -ErrorAction SilentlyContinue; if ((\$null -eq \$c) -or (\$c.IndexOf(\$k) -lt 0)) { Add-Content -Path \$f -Value \$k }; icacls \$f /inheritance:r /grant '$WIN_USER:F' | Out-Null; icacls \$d /inheritance:r /grant '$WIN_USER:F' | Out-Null; try { New-Item -ItemType Directory -Force -Path 'C:/ProgramData/ssh' | Out-Null; \$a='C:/ProgramData/ssh/administrators_authorized_keys'; if (-not (Test-Path \$a)) { New-Item -ItemType File -Path \$a | Out-Null }; \$ac=Get-Content \$a -Raw -ErrorAction SilentlyContinue; if ((\$null -eq \$ac) -or (\$ac.IndexOf(\$k) -lt 0)) { Add-Content -Path \$a -Value \$k }; icacls \$a /inheritance:r /grant 'Administrators:F' /grant 'SYSTEM:F' | Out-Null; Write-Output '   [admin] chiave aggiunta anche a administrators_authorized_keys' } catch { Write-Output '   [info] utente non admin: administrators_authorized_keys saltato' }; exit 0\"" \
        || { echo "❌ Installazione chiave fallita."; exit 1; }

    # 4. Verifica (con diagnostica in caso di fallimento)
    if ssh -o BatchMode=yes -o PasswordAuthentication=no "$WIN_USER@$WIN_IP" exit 2>/dev/null; then
        echo "✅ Fatto: login SSH senza password attivo."
    else
        echo "⚠️  Verifica non riuscita. Diagnostica:"
        ssh -vv -o BatchMode=yes -o PasswordAuthentication=no -o ConnectTimeout=5 \
            "$WIN_USER@$WIN_IP" exit 2>&1 \
            | grep -iE "refused|denied|unprotected|bad ownership|too open|authentications that can continue" \
            | head -4 | sed 's/^/     /'
        echo "    Se il problema sono i permessi, setup-ssh ha già provato a correggerli."
        echo "    Su Windows verifica manualmente: C:\\Users\\$WIN_USER\\.ssh\\authorized_keys"
        exit 1
    fi
}

tunnel_start() {
    local name="$1" lport="$2" rport="$3"
    if use_systemd; then
        systemctl --user start "pcwin-$name.service" 2>/dev/null \
            && echo "✅ pcwin-$name.service avviato → http://localhost:$lport"
    else
        local pidfile="$HOME/.local/state/pcwin/$name.pid"
        mkdir -p "$(dirname "$pidfile")"
        if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
            echo "✅ Tunnel $name già attivo (porta $lport)."
            return
        fi
        check_reachable
        ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
            -L "$lport:localhost:$rport" "$WIN_USER@$WIN_IP" &
        echo $! > "$pidfile"
        echo "✅ Tunnel $name avviato → http://localhost:$lport"
    fi
}

tunnel_stop() {
    local name="$1"
    if use_systemd; then
        systemctl --user stop "pcwin-$name.service" 2>/dev/null \
            && echo "🛑 pcwin-$name.service fermato."
    else
        local pidfile="$HOME/.local/state/pcwin/$name.pid"
        [ -f "$pidfile" ] && kill "$(cat "$pidfile")" 2>/dev/null && rm -f "$pidfile" \
            && echo "🛑 Tunnel $name fermato." || echo "Tunnel $name non attivo."
    fi
}

tunnel_auto() {
    local name="$1" action="$2"
    if ! use_systemd; then
        echo "I service systemd non sono installati. Esegui prima:"
        echo "  pcwin installa-service"
        exit 1
    fi
    systemctl --user "$action" "pcwin-$name.service"
    echo "$([ "$action" = enable ] && echo '🔁 Avvio automatico attivo' || echo '⏸️  Avvio automatico disattivo') per pcwin-$name"
}

installa_service() {
    mkdir -p "$USER_SYSTEMD"
    # Windows ACCESO: tunnel su; se cade (router, sospensione, reboot) →
    # riconnessione automatica rapida (RestartSec=10).
    # Windows SPENTO: max 2 tentativi poi silenzio assoluto (StartLimit):
    # niente ping né processi in background fino al prossimo login o a CONNECT.
    local common="After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=2

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3"

    cat > "$USER_SYSTEMD/pcwin-tramamind.service" <<EOF
[Unit]
Description=LovyPC tunnel → TramaMind OmniRoute ($WIN_IP:20128)
$common -L 20128:localhost:20128 $WIN_USER@$WIN_IP
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF
    cat > "$USER_SYSTEMD/pcwin-tramamind-ui.service" <<EOF
[Unit]
Description=LovyPC tunnel → TramaMind OpenHands ($WIN_IP:3000)
$common -L 3000:localhost:3000 $WIN_USER@$WIN_IP
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF
    cat > "$USER_SYSTEMD/pcwin-ollama.service" <<EOF
[Unit]
Description=LovyPC tunnel → Ollama ($WIN_IP:11434) — debug
$common -L 11434:localhost:11434 $WIN_USER@$WIN_IP
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    # enable-linger: i service partono anche senza login grafico
    if ! loginctl show-user "$USER" 2>/dev/null | grep -q "Linger=yes"; then
        loginctl enable-linger "$USER" 2>/dev/null \
            && echo "🔁 Linger attivo: i service partono anche senza login."
    fi
    echo "✅ Service installati in $USER_SYSTEMD"
    echo "   Avvio:     pcwin tramamind"
    echo "   Auto:      pcwin tramamind auto"
    echo "   Log:       journalctl --user -u pcwin-tramamind -f"
}

disinstalla_service() {
    if [ ! -d "$USER_SYSTEMD" ]; then
        echo "Nessun service installato."
        exit 0
    fi
    for s in tramamind tramamind-ui ollama; do
        systemctl --user disable --now "pcwin-$s.service" 2>/dev/null
        rm -f "$USER_SYSTEMD/pcwin-$s.service"
    done
    systemctl --user daemon-reload
    rm -rf "$HOME/.local/state/pcwin"
    echo "✅ Service disinstallati, PID file rimossi."
}

# ---------- comandi ----------
case "$1" in
    term)
        check_reachable
        ssh "$WIN_USER@$WIN_IP"
        ;;
    cmd)
        check_reachable
        ssh "$WIN_USER@$WIN_IP" "cmd"
        ;;
    monta)
        require sshfs fuse-sshfs
        # Il vecchio punto è dentro la home: va via anche se Windows è spento.
        if [ "$LEGACY_MOUNT" != "$MOUNT_POINT" ]; then
            smonta_path "$LEGACY_MOUNT" || true
        fi
        if is_mounted "$MOUNT_POINT"; then
            echo "✅ Già montato in $MOUNT_POINT"
        else
            check_reachable
            mkdir -p "$(dirname -- "$MOUNT_POINT")"
            if [ ! -d "$MOUNT_POINT" ]; then
                mkdir -- "$MOUNT_POINT"
            fi
            sshfs "${WIN_USER}@${WIN_IP}:${WIN_FOLDER}" "$MOUNT_POINT" \
                -o "$SSHFS_OPTS" \
                && echo "✅ Montato in $MOUNT_POINT" \
                || { echo "❌ Mount fallito."; exit 1; }
        fi
        ;;
    smonta)
        any=0
        fail=0
        prev=""
        for mp in "$MOUNT_POINT" "$LEGACY_MOUNT"; do
            [ "$mp" = "$prev" ] && continue
            prev="$mp"
            smonta_path "$mp"
            rc=$?
            [ "$rc" -eq 0 ] && any=1
            [ "$rc" -eq 1 ] && fail=1
        done
        if [ "$fail" -eq 1 ]; then
            exit 1
        fi
        if [ "$any" -eq 0 ]; then
            echo "Niente da smontare."
        fi
        ;;
    gui)
        "$0" monta && xdg-open "$MOUNT_POINT" 2>/dev/null &
        ;;
    setup-ssh)
        setup_ssh
        ;;
    tramamind)
        case "$2" in
            stop)   tunnel_stop tramamind ;;
            auto)   tunnel_auto tramamind enable ;;
            noauto) tunnel_auto tramamind disable ;;
            ui)     case "$3" in
                        stop)   tunnel_stop tramamind-ui ;;
                        auto)   tunnel_auto tramamind-ui enable ;;
                        noauto) tunnel_auto tramamind-ui disable ;;
                        *)      tunnel_start tramamind-ui 3000 3000
                                echo "   OpenHands → http://localhost:3000" ;;
                    esac ;;
            *)      tunnel_start tramamind 20128 20128
                    echo "   OmniRoute → http://localhost:20128"
                    echo "   Esporta:  export OPENAI_BASE_URL=http://localhost:20128/v1" ;;
        esac
        ;;
    ollama)
        case "$2" in
            stop) tunnel_stop ollama ;;
            *)    tunnel_start ollama 11434 11434
                  echo "   Ollama → http://localhost:11434 (debug: usa solo se OmniRoute non risponde)" ;;
        esac
        ;;
    omniroute)
        echo "ℹ️  'omniroute' è ora 'tramamind' — uso il nuovo nome."
        "$0" tramamind "${@:2}"
        ;;
    installa-service)
        installa_service
        ;;
    disinstalla-service)
        disinstalla_service
        ;;
    status)
        echo "PC Windows: $WIN_USER@$WIN_IP  (cartella: $WIN_FOLDER)"
        ping -c1 -W2 "$WIN_IP" &>/dev/null \
            && echo "  🟢 Rete: raggiungibile" || echo "  🔴 Rete: NON raggiungibile"
        if use_systemd; then
            for s in tramamind tramamind-ui ollama; do
                local_state=$(systemctl --user is-active "pcwin-$s.service" 2>/dev/null)
                enabled=$(systemctl --user is-enabled "pcwin-$s.service" 2>/dev/null)
                case "$local_state" in
                    active)   echo "  🟢 pcwin-$s: attivo $([ "$enabled" = enabled ] && echo '(auto)')" ;;
                    failed)   echo "  🔴 pcwin-$s: fallito (Windows spento?)" ;;
                    *)        echo "  ⚪ pcwin-$s: $local_state" ;;
                esac
            done
        else
            for t in tramamind tramamind-ui ollama; do
                pidf="$HOME/.local/state/pcwin/$t.pid"
                [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null \
                    && echo "  🟢 Tunnel $t: attivo" || echo "  ⚪ Tunnel $t: spento"
            done
            echo "  💡 Service systemd non installati → pcwin installa-service"
        fi
        if is_mounted "$MOUNT_POINT"; then
            echo "  🟢 Cartelle: montate in $MOUNT_POINT"
        elif [ "$LEGACY_MOUNT" != "$MOUNT_POINT" ] && is_mounted "$LEGACY_MOUNT"; then
            echo "  🟡 Cartelle: ancora in $LEGACY_MOUNT"
            echo "     Rimonta con: pcwin monta  (le sposta fuori dalla home)"
        else
            echo "  ⚪ Cartelle: non montate"
        fi
        ;;
    *)
        cat <<'EOF'
pcwin — Controlla il tuo PC Windows dal tuo Fedora

  pcwin term                 Terminale PowerShell sul PC Windows
  pcwin cmd                  Prompt cmd.exe remoto
  pcwin monta | smonta       Monta/smonta le cartelle in ~/.local/share/lovypc/pc-windows
  pcwin gui                  Monta e apri il Gestore file
  pcwin setup-ssh            Accesso senza password (chiave SSH, una tantum)

  pcwin tramamind            Tunnel → OmniRoute :20128 (endpoint principale)
  pcwin tramamind stop       Ferma il tunnel
  pcwin tramamind auto       Avvio automatico al login (systemd)
  pcwin tramamind noauto     Disattiva avvio automatico
  pcwin tramamind ui         Tunnel → OpenHands :3000
  pcwin tramamind ui stop

  pcwin ollama               Tunnel → Ollama :11434 (solo debug)
  pcwin omniroute            Alias di tramamind (retrocompatibilità)

  pcwin installa-service     Crea i service systemd user
  pcwin disinstalla-service  Rimuovi service e PID file
  pcwin status               Panoramica completa

Log: journalctl --user -u pcwin-tramamind -f
Config: ~/.config/pcwin.conf
EOF
        ;;
esac
