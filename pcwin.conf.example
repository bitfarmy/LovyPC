# Configurazione pcwin — modifica con i tuoi dati
WIN_USER="NomeUtenteWindows"
WIN_IP="192.168.1.x"

# Cartella Windows da montare (usa / anche se è Windows)
WIN_FOLDER="C:/Users/NomeUtenteWindows"

# Dove montarla sul Fedora
MOUNT_POINT="$HOME/pc-windows"

# Porte OmniRoute (default: 7337)
OMNI_LOCAL_PORT=7337
OMNI_REMOTE_PORT=7337
